    "clsx": "^2.1.1",
    "express": "^5.1.0",
    "html-to-image": "^1.11.11",
    "lucide-react": "^1.67.0",
    "monaco-editor": "^0.57.0",
    "next": "^16.4.5",
    "next-themes": "^0.4.6",
    "node-sql-parser": "^5.4.0",
    "papaparse": "^5.7.0",
