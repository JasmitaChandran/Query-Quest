{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "services",
    "outDir": "dist-services",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true
  },
  "include": ["services/*/src/**/*.ts", "services/shared/src/**/*.ts"],
  "exclude": ["services/**/*.test.ts", "services/**/__tests__/**"]
}
